{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "noi-tai-an",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-10-26",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "hyperdrive": [
    {
      "binding": "HYPERDRIVE",
      "id": "5513bb7e652c47f2a13e8fa19463afee"
    }
  ],
  "observability": {
    "enabled": true
  }
}
