# ===== Bắt buộc =====
# PostgreSQL trên VPS
DATABASE_URL="postgresql://noitaian:MAT_KHAU@127.0.0.1:5432/noitaian?schema=public"
# Tạo bằng: openssl rand -base64 32
AUTH_SECRET=""
AUTH_URL="https://ten-mien-cua-ban.vn"
AUTH_TRUST_HOST=true

# Google OAuth — https://console.cloud.google.com/apis/credentials
# Authorized redirect URI: https://ten-mien-cua-ban.vn/api/auth/callback/google
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# Email được cấp quyền ADMIN khi đăng nhập lần đầu (phân tách bằng dấu phẩy)
ADMIN_EMAILS=""

# ===== Thanh toán (Giai đoạn 2) =====
# payos | sepay  (để trống trên máy local = chế độ giả lập; production bắt buộc chọn 1)
PAYMENT_PROVIDER="sepay"

# PayOS — https://my.payos.vn → Kênh thanh toán. Webhook: https://ten-mien.vn/api/payments/payos
PAYOS_CLIENT_ID=""
PAYOS_API_KEY=""
PAYOS_CHECKSUM_KEY=""

# SePay — https://my.sepay.vn. Webhook: https://ten-mien.vn/api/payments/sepay (chứng thực API Key)
SEPAY_API_KEY=""
SEPAY_BANK="MBBank"            # mã ngân hàng theo qr.sepay.vn (VD: MBBank, Vietcombank, ACB, TPBank…)
SEPAY_ACCOUNT_NO=""
SEPAY_ACCOUNT_NAME=""

# ===== Thông tin pháp lý (hiển thị ở footer & trang chính sách) =====
BUSINESS_LEGAL_NAME=""
BUSINESS_TAX_ID=""
BUSINESS_ADDRESS=""
SUPPORT_EMAIL=""
SUPPORT_PHONE=""

# ===== Chỉ dùng khi phát triển local — KHÔNG bật trên production =====
ALLOW_DEV_LOGIN=false
