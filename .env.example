# ===== Bắt buộc =====
# Supabase (Project Settings → Database → Connection string)
# DATABASE_URL: Connection pooling (cổng 6543, kèm pgbouncer=true) — dùng cho app lúc chạy
# DIRECT_URL: Direct connection (cổng 5432) — chỉ dùng khi chạy migrate/db push
DATABASE_URL="postgresql://postgres.xxxxxxxxxxxx:MAT_KHAU@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"
DIRECT_URL="postgresql://postgres.xxxxxxxxxxxx:MAT_KHAU@aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres"
# Tạo bằng: openssl rand -base64 32
AUTH_SECRET=""
AUTH_URL="https://ten-mien-cua-ban.vn"
AUTH_TRUST_HOST=true

# Google OAuth — https://console.cloud.google.com/apis/credentials
# Authorized redirect URI: https://ten-mien-cua-ban.vn/api/auth/callback/google
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# Email được cấp quyền ADMIN khi đăng nhập lần đầu (phân tách bằng dấu phẩy)
ADMIN_EMAILS=""

# ===== Thanh toán (Giai đoạn 2) =====
# payos | sepay  (để trống trên máy local = chế độ giả lập; production bắt buộc chọn 1)
PAYMENT_PROVIDER="sepay"

# PayOS — https://my.payos.vn → Kênh thanh toán. Webhook: https://ten-mien.vn/api/payments/payos
PAYOS_CLIENT_ID=""
PAYOS_API_KEY=""
PAYOS_CHECKSUM_KEY=""

# SePay — https://my.sepay.vn. Webhook: https://ten-mien.vn/api/payments/sepay (chứng thực API Key)
SEPAY_API_KEY=""
SEPAY_BANK="MBBank"            # mã ngân hàng theo qr.sepay.vn (VD: MBBank, Vietcombank, ACB, TPBank…)
SEPAY_ACCOUNT_NO=""
SEPAY_ACCOUNT_NAME=""

# ===== Cloudflare R2 — ảnh cộng đồng (Giai đoạn 3) =====
# Dashboard Cloudflare → R2 → tạo bucket → Manage R2 API Tokens (quyền Object Read & Write cho bucket)
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET="noitaian-media"
# Tên miền công khai của bucket (Custom Domain, VD https://media.ten-mien.vn) hoặc r2.dev
R2_PUBLIC_URL=""

# ===== Thông tin pháp lý (hiển thị ở footer & trang chính sách) =====
BUSINESS_LEGAL_NAME=""
BUSINESS_TAX_ID=""
BUSINESS_ADDRESS=""
SUPPORT_EMAIL=""
SUPPORT_PHONE=""

# ===== Chỉ dùng khi phát triển local — KHÔNG bật trên production =====
ALLOW_DEV_LOGIN=false
