// Nội Tại Ẩn — data model
// Giai đoạn 1: Auth, Goals, Projects, Tasks, Habits, Focus, Daily plan, Settings.
// Giai đoạn 2–3 (Reflection, Payment, Community) sẽ mở rộng thêm model.

generator client {
  provider = "prisma-client"
  runtime  = "nodejs"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  USER
  ADMIN
}

enum Plan {
  FREE
  PRO
  TEAM
}

enum ThemePref {
  LIGHT
  DARK
  SYSTEM
}

enum GoalHorizon {
  YEAR
  QUARTER
  MONTH
  WEEK
}

enum GoalStatus {
  ACTIVE
  COMPLETED
  PAUSED
  ARCHIVED
}

enum ProjectStatus {
  ACTIVE
  DONE
  ARCHIVED
}

enum TaskStatus {
  TODO
  DONE
}

// ---------- Auth.js ----------

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  role          Role      @default(USER)
  plan          Plan      @default(FREE)
  planExpiresAt DateTime?

  // Cài đặt giao diện & thói quen làm việc
  locale         String    @default("vi")
  theme          ThemePref @default(SYSTEM)
  accent         String    @default("ochre")
  density        String    @default("comfortable")
  timezone       String    @default("Asia/Ho_Chi_Minh")
  weekStartsOn   Int       @default(1) // 0 = CN, 1 = T2
  focusMinutes   Int       @default(25)
  breakMinutes   Int       @default(5)
  dailyFocusGoal Int       @default(120) // phút
  onboardedAt    DateTime?
  bannedAt       DateTime? // Admin khoá tài khoản
  teamSeats      Int? // số chỗ khi mua gói Team

  // H5. Hồ sơ hành trình & quyền riêng tư
  username              String? @unique
  bio                   String?
  profilePublic         Boolean @default(false)
  showGoals             Boolean @default(true)
  showStats             Boolean @default(true)
  showBadges            Boolean @default(true)
  showChallenges        Boolean @default(true)
  leaderboardOptIn      Boolean @default(true)
  autoShareAchievements Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  accounts      Account[]
  sessions      Session[]
  goals         Goal[]
  projects      Project[]
  tasks         Task[]
  habits        Habit[]
  habitLogs     HabitLog[]
  focusSessions FocusSession[]
  dailyPlans    DailyPlan[]
  journals      JournalEntry[]
  weeklyReviews WeeklyReview[]
  orders        Order[]
  workCustomers WorkCustomer[]

  posts                    Post[]
  cheers                   Cheer[]
  comments                 Comment[]
  reports                  Report[]
  challenges               Challenge[]        @relation("ChallengeCreator")
  challengeMembers         ChallengeMember[]
  challengeCheckins        ChallengeCheckin[]
  groupMembers             GroupMember[]
  badges                   UserBadge[]
  joinRequests             GroupJoinRequest[]
  following                Follow[]           @relation("Follower")
  followers                Follow[]           @relation("Following")
  challengeInvitesSent     ChallengeInvite[]  @relation("Inviter")
  challengeInvitesReceived ChallengeInvite[]  @relation("Invitee")
}

model Account {
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([provider, providerAccountId])
}

model Session {
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@id([identifier, token])
}

// ---------- B. Goal System ----------

model Goal {
  id          String      @id @default(cuid())
  userId      String
  title       String
  description String?
  why         String? // Lý do sâu xa — nền tảng "nội tại"
  horizon     GoalHorizon
  year        Int
  quarter     Int? // 1–4
  month       Int? // 1–12
  weekStart   DateTime?   @db.Date // cột mốc tuần: ngày đầu tuần
  status      GoalStatus  @default(ACTIVE)
  color       String      @default("ochre")

  // Mục tiêu đo lường được (tuỳ chọn)
  targetValue  Float?
  currentValue Float   @default(0)
  unit         String?

  dueDate     DateTime? @db.Date
  completedAt DateTime?
  parentId    String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  parent   Goal?     @relation("GoalTree", fields: [parentId], references: [id], onDelete: SetNull)
  children Goal[]    @relation("GoalTree")
  projects Project[]
  tasks    Task[]
  habits   Habit[]

  @@index([userId, horizon, year])
}

model Project {
  id          String        @id @default(cuid())
  userId      String
  goalId      String?
  title       String
  description String?
  status      ProjectStatus @default(ACTIVE)
  dueDate     DateTime?     @db.Date

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user  User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  goal  Goal?  @relation(fields: [goalId], references: [id], onDelete: SetNull)
  tasks Task[]

  @@index([userId, goalId])
}

// ---------- D. Daily Execution ----------

model Task {
  id          String     @id @default(cuid())
  userId      String
  goalId      String?
  projectId   String?
  title       String
  notes       String?
  date        DateTime?  @db.Date // null = backlog / hành động chưa lên lịch
  priority    Int? // 1..3 = Top 3 ưu tiên của ngày
  startTime   String? // "HH:mm" để hiện trên timeline
  estimateMin Int?
  status      TaskStatus @default(TODO)
  completedAt DateTime?
  sortOrder   Int        @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  goal          Goal?          @relation(fields: [goalId], references: [id], onDelete: SetNull)
  project       Project?       @relation(fields: [projectId], references: [id], onDelete: SetNull)
  focusSessions FocusSession[]

  @@index([userId, date])
  @@index([userId, goalId])
}

model FocusSession {
  id             String   @id @default(cuid())
  userId         String
  taskId         String?
  label          String?
  plannedMinutes Int
  actualMinutes  Int
  completed      Boolean  @default(true)
  date           DateTime @db.Date
  startedAt      DateTime
  endedAt        DateTime @default(now())

  user User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  task Task? @relation(fields: [taskId], references: [id], onDelete: SetNull)

  @@index([userId, date])
}

model DailyPlan {
  id        String   @id @default(cuid())
  userId    String
  date      DateTime @db.Date
  intention String?
  energy    Int? // 1–5

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, date])
}

// ---------- C. Habit Tracker ----------

model Habit {
  id           String    @id @default(cuid())
  userId       String
  goalId       String?
  name         String
  description  String?
  icon         String    @default("circle-check")
  color        String    @default("jade")
  // Ngày trong tuần áp dụng (0 = CN … 6 = T7). Rỗng = mỗi ngày.
  daysOfWeek   Int[]     @default([])
  targetPerDay Int       @default(1)
  sortOrder    Int       @default(0)
  archivedAt   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  goal Goal?      @relation(fields: [goalId], references: [id], onDelete: SetNull)
  logs HabitLog[]

  @@index([userId])
}

model HabitLog {
  id      String   @id @default(cuid())
  habitId String
  userId  String
  date    DateTime @db.Date
  count   Int      @default(1)

  createdAt DateTime @default(now())

  habit Habit @relation(fields: [habitId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([habitId, date])
  @@index([userId, date])
}

// ---------- F. Reflection ----------

model JournalEntry {
  id                  String   @id @default(cuid())
  userId              String
  date                DateTime @db.Date
  mood                Int? // 1–5
  wins                String?
  lessons             String?
  gratitude           String?
  tomorrow            String? // một cải thiện cho ngày mai
  // Nguyên nhân trì hoãn (mã: unclear, too_big, distraction, fatigue, fear, perfectionism, low_energy, other)
  procrastination     String[] @default([])
  procrastinationNote String?
  // Người viết tự bật để chia sẻ ẩn danh cho người dùng khác đọc (tab "Ngẫu nhiên")
  isPublic            Boolean  @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, date])
  @@index([isPublic])
}

// ---------- G. Không gian "Công việc" (demo CRM khách hàng) ----------

model WorkCustomer {
  id            String    @id @default(cuid())
  userId        String
  name          String
  email         String
  city          String?
  channel       String // ONLINE | IN_STORE
  orders        Int       @default(0)
  lifetimeCents Int       @default(0)
  lastOrderAt   DateTime?
  tags          String[]  @default([])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model WeeklyReview {
  id         String   @id @default(cuid())
  userId     String
  weekStart  DateTime @db.Date
  rating     Int? // 1–10
  highlights String?
  obstacles  String?
  rootCause  String?
  experiment String? // thử nghiệm cải thiện tuần tới
  nextFocus  String? // 3 trọng tâm tuần tới

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, weekStart])
}

// ---------- G. Payment ----------

enum OrderStatus {
  PENDING
  PAID
  CANCELLED
  EXPIRED
}

enum BillingCycle {
  MONTHLY
  YEARLY
}

model Order {
  id          String       @id @default(cuid())
  code        String       @unique // mã nội dung chuyển khoản, VD: NTA8F3K2Q
  orderCode   Int          @unique // mã số cho PayOS
  userId      String
  plan        Plan
  cycle       BillingCycle
  seats       Int          @default(1)
  amount      Int // VND
  provider    String // payos | sepay | mock
  status      OrderStatus  @default(PENDING)
  checkoutUrl String?
  providerRef String? // mã giao dịch phía cổng thanh toán
  paidAt      DateTime?
  expiresAt   DateTime

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([status, createdAt])
  @@index([userId])
}

// ---------- H. Cộng đồng ----------

enum PostCategory {
  READING
  WORKOUT
  STUDY
  FOCUS
  GOAL
  OTHER
}

enum PostKind {
  POST
  CHECKIN // check-in thử thách
  SUMMARY // tổng kết tuần trong nhóm
  ACHIEVEMENT // thành tích tự động (chuỗi cá nhân / nhóm)
}

model Post {
  id           String       @id @default(cuid())
  userId       String
  kind         PostKind     @default(POST)
  category     PostCategory @default(OTHER)
  content      String
  imageKey     String?
  imageUrl     String?
  groupId      String? // null = bảng tin công khai; có giá trị = chỉ thành viên nhóm thấy
  challengeId  String?
  hiddenAt     DateTime? // bị ẩn bởi kiểm duyệt
  cheerCount   Int          @default(0)
  commentCount Int          @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  group     Group?     @relation(fields: [groupId], references: [id], onDelete: Cascade)
  challenge Challenge? @relation(fields: [challengeId], references: [id], onDelete: SetNull)
  cheers    Cheer[]
  comments  Comment[]

  @@index([groupId, createdAt])
  @@index([challengeId, createdAt])
  @@index([userId, createdAt])
  @@index([createdAt])
}

model Cheer {
  postId    String
  userId    String
  createdAt DateTime @default(now())

  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([postId, userId])
}

model Comment {
  id        String    @id @default(cuid())
  postId    String
  userId    String
  content   String
  hiddenAt  DateTime?
  createdAt DateTime  @default(now())

  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([postId, createdAt])
}

enum ReportStatus {
  OPEN
  RESOLVED
  DISMISSED
}

model Report {
  id         String       @id @default(cuid())
  reporterId String
  postId     String?
  commentId  String?
  reason     String
  status     ReportStatus @default(OPEN)
  resolvedBy String?
  createdAt  DateTime     @default(now())
  resolvedAt DateTime?

  reporter User @relation(fields: [reporterId], references: [id], onDelete: Cascade)

  @@index([status, createdAt])
}

model Challenge {
  id           String       @id @default(cuid())
  creatorId    String
  title        String
  description  String?
  category     PostCategory @default(OTHER)
  durationDays Int // 7 | 21 | 30
  startDate    DateTime     @db.Date
  official     Boolean      @default(false)
  badgeName    String?
  archivedAt   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  creator  User               @relation("ChallengeCreator", fields: [creatorId], references: [id], onDelete: Cascade)
  members  ChallengeMember[]
  invites  ChallengeInvite[]
  checkins ChallengeCheckin[]
  posts    Post[]

  @@index([startDate])
}

model ChallengeMember {
  challengeId String
  userId      String
  joinedAt    DateTime  @default(now())
  completedAt DateTime?

  challenge Challenge @relation(fields: [challengeId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([challengeId, userId])
  @@index([userId])
}

model ChallengeCheckin {
  id          String   @id @default(cuid())
  challengeId String
  userId      String
  date        DateTime @db.Date
  note        String?
  createdAt   DateTime @default(now())

  challenge Challenge @relation(fields: [challengeId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([challengeId, userId, date])
  @@index([userId, date])
}

enum GroupRole {
  OWNER
  MEMBER
}

model Group {
  id          String  @id @default(cuid())
  name        String
  description String?
  ownerId     String
  inviteCode  String  @unique
  maxMembers  Int     @default(10)

  // Nhóm công khai: hiện trong tìm kiếm/gợi ý, thành viên Pro được xin tham gia
  isPublic Boolean       @default(false)
  category PostCategory?
  city     String?
  // Toạ độ làm tròn ~1km (2 chữ số thập phân) để bảo vệ quyền riêng tư
  lat      Float?
  lng      Float?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  members      GroupMember[]
  posts        Post[]
  joinRequests GroupJoinRequest[]

  @@index([isPublic])
}

enum JoinRequestStatus {
  PENDING
  APPROVED
  REJECTED
}

model GroupJoinRequest {
  id         String            @id @default(cuid())
  groupId    String
  userId     String
  message    String?
  status     JoinRequestStatus @default(PENDING)
  reviewedBy String?
  createdAt  DateTime          @default(now())
  reviewedAt DateTime?

  group Group @relation(fields: [groupId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([groupId, status])
  @@index([userId, status])
}

/**
 * Chống đăng trùng thành tích tự động. key VD: streak:<habitId>:<mốc>:<ngày bắt đầu chuỗi>
 */
model Achievement {
  key       String   @id
  userId    String?
  groupId   String?
  createdAt DateTime @default(now())
}

model GroupMember {
  groupId        String
  userId         String
  role           GroupRole @default(MEMBER)
  commitment     String? // cam kết tuần này
  commitmentWeek DateTime? @db.Date
  joinedAt       DateTime  @default(now())

  group Group @relation(fields: [groupId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([groupId, userId])
  @@index([userId])
}

model UserBadge {
  userId    String
  code      String
  awardedAt DateTime @default(now())
  meta      String? // VD: tên thử thách

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, code])
}

// ---------- Theo dõi hồ sơ ----------

model Follow {
  followerId  String
  followingId String
  createdAt   DateTime @default(now())

  follower  User @relation("Follower", fields: [followerId], references: [id], onDelete: Cascade)
  following User @relation("Following", fields: [followingId], references: [id], onDelete: Cascade)

  @@id([followerId, followingId])
  @@index([followingId])
}

enum InviteStatus {
  PENDING
  ACCEPTED
  DECLINED
}

model ChallengeInvite {
  id          String       @id @default(cuid())
  challengeId String
  inviterId   String
  inviteeId   String
  status      InviteStatus @default(PENDING)
  createdAt   DateTime     @default(now())

  challenge Challenge @relation(fields: [challengeId], references: [id], onDelete: Cascade)
  inviter   User      @relation("Inviter", fields: [inviterId], references: [id], onDelete: Cascade)
  invitee   User      @relation("Invitee", fields: [inviteeId], references: [id], onDelete: Cascade)

  @@unique([challengeId, inviteeId])
  @@index([inviteeId, status])
}
