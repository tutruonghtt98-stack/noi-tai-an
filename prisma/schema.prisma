// Nội Tại Ẩn — data model
// Giai đoạn 1: Auth, Goals, Projects, Tasks, Habits, Focus, Daily plan, Settings.
// Giai đoạn 2–3 (Reflection, Payment, Community) sẽ mở rộng thêm model.

generator client {
  provider = "prisma-client"
  runtime  = "nodejs"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  USER
  ADMIN
}

enum Plan {
  FREE
  PRO
  TEAM
}

enum ThemePref {
  LIGHT
  DARK
  SYSTEM
}

enum GoalHorizon {
  YEAR
  QUARTER
  MONTH
  WEEK
}

enum GoalStatus {
  ACTIVE
  COMPLETED
  PAUSED
  ARCHIVED
}

enum ProjectStatus {
  ACTIVE
  DONE
  ARCHIVED
}

enum TaskStatus {
  TODO
  DONE
}

enum JourneyProgramStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum JourneyStatus {
  ACTIVE
  PAUSED
  COMPLETED
  ABANDONED
}

enum JourneyDayStatus {
  IN_PROGRESS
  COMPLETED
  REST
  MISSED
}

enum JourneyOfferStatus {
  PENDING
  ACCEPTED
  DECLINED
}

enum JourneyMissionType {
  HEALTH
  PERSONAL_GROWTH
  PRODUCTIVITY
  REFLECTION
}

// ---------- Auth.js ----------

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  role          Role      @default(USER)
  plan          Plan      @default(FREE)
  planExpiresAt DateTime?

  // Cài đặt giao diện & thói quen làm việc
  locale         String    @default("vi")
  theme          ThemePref @default(SYSTEM)
  accent         String    @default("ochre")
  density        String    @default("comfortable")
  timezone       String    @default("Asia/Ho_Chi_Minh")
  weekStartsOn   Int       @default(1) // 0 = CN, 1 = T2
  focusMinutes   Int       @default(25)
  breakMinutes   Int       @default(5)
  dailyFocusGoal Int       @default(120) // phút
  onboardedAt    DateTime?
  journeyOfferStatus JourneyOfferStatus?
  bannedAt       DateTime? // Admin khoá tài khoản
  teamSeats      Int? // số chỗ khi mua gói Team

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  accounts           Account[]
  sessions           Session[]
  goals              Goal[]
  projects           Project[]
  tasks              Task[]
  habits             Habit[]
  habitLogs          HabitLog[]
  focusSessions      FocusSession[]
  orders             Order[]
  workCustomers      WorkCustomer[]
  workBoards         WorkBoard[]
  assignedWorkBoards WorkBoard[]       @relation("WorkBoardAssignee")
  assignedWorkCards  WorkCard[]        @relation("WorkCardAssignee")
  workCardComments   WorkCardComment[]
  notifications      Notification[]    @relation("NotificationUser")
  sentNotifications  Notification[]    @relation("NotificationActor")
  badges             UserBadge[]
  journeys           UserJourney[]
  disciplineTransactions DisciplineTransaction[]
  journeyXpTransactions  JourneyXPTransaction[]
  workCardEvents     WorkCardEvent[]       @relation("WorkCardEventActor")
  journeyAdminAudits JourneyAdminAudit[]   @relation("JourneyAdminActor")

  ownedWorkspaces       Workspace[]        @relation("WorkspaceOwner")
  workspaceMemberships  WorkspaceMember[]  @relation("WorkspaceMembership")
  managedDepartments    Department[]       @relation("DepartmentManager")
  departmentMemberships DepartmentMember[] @relation("DepartmentMembership")
  ledTeams              Team[]             @relation("TeamLeader")
  teamMemberships       TeamMember[]       @relation("TeamMembership")
}

model Account {
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([provider, providerAccountId])
}

model Session {
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@id([identifier, token])
}

// ---------- B. Goal System ----------

model Goal {
  id          String      @id @default(cuid())
  userId      String
  title       String
  description String?
  why         String? // Lý do sâu xa — nền tảng "nội tại"
  horizon     GoalHorizon
  year        Int
  quarter     Int? // 1–4
  month       Int? // 1–12
  weekStart   DateTime?   @db.Date // cột mốc tuần: ngày đầu tuần
  status      GoalStatus  @default(ACTIVE)
  color       String      @default("ochre")

  // Mục tiêu đo lường được (tuỳ chọn)
  targetValue  Float?
  currentValue Float   @default(0)
  unit         String?

  dueDate     DateTime? @db.Date
  completedAt DateTime?
  parentId    String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  parent   Goal?     @relation("GoalTree", fields: [parentId], references: [id], onDelete: SetNull)
  children Goal[]    @relation("GoalTree")
  projects Project[]
  tasks    Task[]
  habits   Habit[]

  @@index([userId, horizon, year])
}

model Project {
  id          String        @id @default(cuid())
  userId      String
  goalId      String?
  title       String
  description String?
  status      ProjectStatus @default(ACTIVE)
  dueDate     DateTime?     @db.Date

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user  User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  goal  Goal?  @relation(fields: [goalId], references: [id], onDelete: SetNull)
  tasks Task[]

  @@index([userId, goalId])
}

// ---------- D. Daily Execution ----------

model Task {
  id          String     @id @default(cuid())
  userId      String
  goalId      String?
  projectId   String?
  title       String
  notes       String?
  date        DateTime?  @db.Date // null = backlog / hành động chưa lên lịch
  priority    Int? // 1..3 = Top 3 ưu tiên của ngày
  startTime   String? // "HH:mm" để hiện trên timeline
  estimateMin Int?
  status      TaskStatus @default(TODO)
  completedAt DateTime?
  sortOrder   Int        @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  goal          Goal?          @relation(fields: [goalId], references: [id], onDelete: SetNull)
  project       Project?       @relation(fields: [projectId], references: [id], onDelete: SetNull)
  focusSessions FocusSession[]

  @@index([userId, date])
  @@index([userId, goalId])
}

model FocusSession {
  id             String   @id @default(cuid())
  userId         String
  taskId         String?
  label          String?
  plannedMinutes Int
  actualMinutes  Int
  completed      Boolean  @default(true)
  date           DateTime @db.Date
  startedAt      DateTime
  endedAt        DateTime @default(now())

  user User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  task Task? @relation(fields: [taskId], references: [id], onDelete: SetNull)

  @@index([userId, date])
}

// ---------- C. Habit Tracker ----------

model Habit {
  id           String    @id @default(cuid())
  userId       String
  goalId       String?
  name         String
  description  String?
  icon         String    @default("circle-check")
  color        String    @default("jade")
  // Ngày trong tuần áp dụng (0 = CN … 6 = T7). Rỗng = mỗi ngày.
  daysOfWeek   Int[]     @default([])
  targetPerDay Int       @default(1)
  sortOrder    Int       @default(0)
  archivedAt   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  goal Goal?      @relation(fields: [goalId], references: [id], onDelete: SetNull)
  logs HabitLog[]

  @@index([userId])
}

model HabitLog {
  id      String   @id @default(cuid())
  habitId String
  userId  String
  date    DateTime @db.Date
  count   Int      @default(1)

  createdAt DateTime @default(now())

  habit Habit @relation(fields: [habitId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([habitId, date])
  @@index([userId, date])
}

// ---------- G. Không gian "Công việc" (demo CRM khách hàng) ----------

model WorkCustomer {
  id            String    @id @default(cuid())
  userId        String
  name          String
  email         String
  city          String?
  channel       String // ONLINE | IN_STORE
  orders        Int       @default(0)
  lifetimeCents Int       @default(0)
  lastOrderAt   DateTime?
  tags          String[]  @default([])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model WorkBoard {
  id             String    @id @default(cuid())
  userId         String
  name           String
  description    String?
  dueDate        DateTime?
  assignee       String? // email người phụ trách — chỉ xem/thao tác được thẻ mà chủ bảng cấp quyền (gắn trực tiếp trên thẻ)
  assigneeUserId String?
  teamId         String? // team phụ trách — chỉ xem/thao tác được thẻ mà chủ bảng cấp quyền cho team này
  sortOrder      Int       @default(0)
  createdAt      DateTime  @default(now())

  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  assigneeUser User?      @relation("WorkBoardAssignee", fields: [assigneeUserId], references: [id], onDelete: SetNull)
  team         Team?      @relation(fields: [teamId], references: [id], onDelete: SetNull)
  lists        WorkList[]

  @@index([userId])
  @@index([assigneeUserId])
  @@index([teamId])
}

model WorkList {
  id        String @id @default(cuid())
  boardId   String
  name      String
  color     String // "muted" | "mist" | "ochre" | "jade"
  sortOrder Int    @default(0)

  board WorkBoard  @relation(fields: [boardId], references: [id], onDelete: Cascade)
  cards WorkCard[]

  @@index([boardId])
}

model WorkCard {
  id             String    @id @default(cuid())
  listId         String
  label          String?
  title          String
  assignee       String? // email đã nhập (hiển thị dù chưa khớp tài khoản nào)
  assigneeUserId String? // khớp với User.email nếu có tài khoản tương ứng
  teamId         String? // team được cấp quyền xem/thao tác thẻ này
  checklist      Json      @default("[]")
  dueDate        DateTime?
  completedAt    DateTime? // mốc chuyển vào cột "Hoàn thành" — dùng cho báo cáo trước/đúng/trễ hạn
  sortOrder      Int       @default(0)
  createdAt      DateTime  @default(now())

  list         WorkList          @relation(fields: [listId], references: [id], onDelete: Cascade)
  assigneeUser User?             @relation("WorkCardAssignee", fields: [assigneeUserId], references: [id], onDelete: SetNull)
  team         Team?             @relation(fields: [teamId], references: [id], onDelete: SetNull)
  comments     WorkCardComment[]

  @@index([listId])
  @@index([assigneeUserId])
  @@index([teamId])
}

model WorkCardComment {
  id        String   @id @default(cuid())
  cardId    String
  userId    String
  content   String
  createdAt DateTime @default(now())

  card WorkCard @relation(fields: [cardId], references: [id], onDelete: Cascade)
  user User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([cardId])
}

model Notification {
  id        String   @id @default(cuid())
  userId    String // người nhận
  actorId   String? // người gây ra thông báo (có thể null nếu hệ thống)
  type      String // "WORK_CARD_ASSIGNED" | ...
  title     String
  body      String?
  href      String?
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  user  User  @relation("NotificationUser", fields: [userId], references: [id], onDelete: Cascade)
  actor User? @relation("NotificationActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([userId, read])
  @@index([userId, createdAt])
}

// ---------- G. Payment ----------

enum OrderStatus {
  PENDING
  PAID
  CANCELLED
  EXPIRED
}

enum BillingCycle {
  MONTHLY
  YEARLY
}

model Order {
  id          String       @id @default(cuid())
  code        String       @unique // mã nội dung chuyển khoản, VD: NTA8F3K2Q
  orderCode   Int          @unique // mã số cho PayOS
  userId      String
  plan        Plan
  cycle       BillingCycle
  seats       Int          @default(1)
  amount      Int // VND
  provider    String // payos | sepay | mock
  status      OrderStatus  @default(PENDING)
  checkoutUrl String?
  providerRef String? // mã giao dịch phía cổng thanh toán
  paidAt      DateTime?
  expiresAt   DateTime

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([status, createdAt])
  @@index([userId])
}

model UserBadge {
  userId    String
  code      String
  awardedAt DateTime @default(now())
  meta      String? // VD: tên thử thách

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, code])
}

// ---------- STILL / BETTER 180-day journey ----------

model JourneyProgram {
  id                    String               @id @default(cuid())
  code                  String
  version               Int                  @default(1)
  durationDays          Int                  @default(180)
  title                 String
  description           String?
  status                JourneyProgramStatus @default(DRAFT)
  publishedAt           DateTime?
  createdAt             DateTime             @default(now())
  updatedAt             DateTime             @updatedAt
  levels                JourneyLevel[]
  dailyChallenges       JourneyDailyChallenge[]
  weeklyChallenges      JourneyWeeklyChallenge[]
  quotes                JourneyQuote[]
  achievements          JourneyAchievementDefinition[]
  ruleSets              JourneyRuleSet[]
  journeys              UserJourney[]

  @@unique([code, version])
  @@index([status, publishedAt])
}

model JourneyLevel {
  id                   String                  @id @default(cuid())
  programId            String
  number               Int
  startDay             Int
  endDay               Int
  slug                 String
  title                String
  tagline              String?
  description          String?
  objective            String
  skills               String[]                @default([])
  reflectionQuestions  String[]                @default([])
  completionCriteria   Json?
  reportSections       Json?
  completionThreshold Int                     @default(75)
  createdAt            DateTime                @default(now())
  updatedAt            DateTime                @updatedAt
  program              JourneyProgram          @relation(fields: [programId], references: [id], onDelete: Cascade)
  missions             JourneyMission[]
  weeklyChallenges     JourneyWeeklyChallenge[]
  monthlyChallenge     JourneyMonthlyChallenge?
  reviews              JourneyLevelReview[]
  achievements         JourneyAchievementDefinition[]

  @@unique([programId, number])
  @@unique([programId, slug])
  @@index([programId])
}

model JourneyMission {
  id                  String             @id @default(cuid())
  levelId             String
  dayInLevel          Int
  sequence            Int
  title               String
  description         String
  objective           String
  type                JourneyMissionType
  suggestedMinutes    Int?
  xpReward            Int                @default(0)
  completionCriteria  String
  active              Boolean            @default(true)
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt
  level               JourneyLevel       @relation(fields: [levelId], references: [id], onDelete: Cascade)
  completions         JourneyMissionCompletion[]

  @@unique([levelId, dayInLevel, sequence])
  @@index([levelId, dayInLevel])
}

model JourneyDailyChallenge {
  id              String             @id @default(cuid())
  programId       String
  journeyDay      Int
  title           String
  description     String
  completionCriteria String
  xpReward        Int                @default(0)
  active          Boolean            @default(true)
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt
  program         JourneyProgram     @relation(fields: [programId], references: [id], onDelete: Cascade)
  dayRecords      JourneyDayRecord[]

  @@unique([programId, journeyDay])
}

model JourneyWeeklyChallenge {
  id                 String         @id @default(cuid())
  programId          String
  levelId            String
  weekNumber         Int
  startDay           Int
  endDay             Int
  title              String
  description        String
  completionCriteria String
  xpReward           Int            @default(0)
  active             Boolean        @default(true)
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt
  program            JourneyProgram @relation(fields: [programId], references: [id], onDelete: Cascade)
  level              JourneyLevel   @relation(fields: [levelId], references: [id], onDelete: Cascade)
  completions        JourneyWeeklyChallengeCompletion[]

  @@unique([programId, weekNumber])
  @@index([levelId, weekNumber])
}

model JourneyMonthlyChallenge {
  id                 String       @id @default(cuid())
  levelId            String       @unique
  title              String
  description        String
  completionCriteria Json
  xpReward           Int          @default(0)
  active             Boolean      @default(true)
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt
  level              JourneyLevel @relation(fields: [levelId], references: [id], onDelete: Cascade)
  completions        JourneyMonthlyChallengeCompletion[]
}

model JourneyQuote {
  id        String         @id @default(cuid())
  programId String
  quote     String
  author    String?
  dayNumber Int?
  active    Boolean        @default(true)
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
  program   JourneyProgram @relation(fields: [programId], references: [id], onDelete: Cascade)

  @@index([programId, dayNumber, active])
}

model JourneyAchievementDefinition {
  id          String         @id @default(cuid())
  programId   String
  levelId     String?
  code        String
  title       String
  description String
  metric      String
  threshold   Int?
  xpReward    Int            @default(0)
  active      Boolean        @default(true)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  program     JourneyProgram @relation(fields: [programId], references: [id], onDelete: Cascade)
  level       JourneyLevel?  @relation(fields: [levelId], references: [id], onDelete: SetNull)
  awards      JourneyAchievement[]

  @@unique([programId, code])
  @@index([levelId, active])
}

model JourneyAchievement {
  id           String                       @id @default(cuid())
  journeyId    String
  definitionId String
  awardedAt    DateTime                     @default(now())
  snapshot     Json?
  journey      UserJourney                  @relation(fields: [journeyId], references: [id], onDelete: Cascade)
  definition   JourneyAchievementDefinition @relation(fields: [definitionId], references: [id], onDelete: Restrict)

  @@unique([journeyId, definitionId])
  @@index([journeyId, awardedAt])
}

model JourneyRuleSet {
  id                              String         @id @default(cuid())
  programId                       String
  version                         Int            @default(1)
  missionWeight                   Int            @default(60)
  habitWeight                     Int            @default(20)
  workspaceWeight                 Int            @default(20)
  levelCompletionThreshold        Int            @default(75)
  earlyCompletionPoints           Int            @default(15)
  onTimeCompletionPoints          Int            @default(10)
  importantWorkBonus              Int            @default(5)
  assignedAndCompletedSameDayBonus Int            @default(5)
  overdueFirstDayPenalty           Int            @default(5)
  overdueAdditionalDayPenalty      Int            @default(2)
  maxOverduePenalty                Int?
  importantLabel                  String         @default("IMPORTANT")
  teamAssignmentPolicy            String         @default("DIRECT_ONLY")
  publishedAt                     DateTime?
  createdAt                       DateTime       @default(now())
  updatedAt                       DateTime       @updatedAt
  program                         JourneyProgram @relation(fields: [programId], references: [id], onDelete: Cascade)
  journeys                        UserJourney[]

  @@unique([programId, version])
}

model UserJourney {
  id                String                   @id @default(cuid())
  userId            String
  programId         String
  ruleSetId         String
  status            JourneyStatus            @default(ACTIVE)
  timezone          String                   @default("Asia/Ho_Chi_Minh")
  currentDay        Int                      @default(1)
  // Cam kết ban đầu người dùng chọn lúc bắt đầu hành trình (vd. giờ thức dậy cố định, mục tiêu chính).
  // Dạng Json để mở rộng thêm câu hỏi về sau mà không cần migration mới.
  commitments       Json?
  joinedAt          DateTime                 @default(now())
  pausedAt          DateTime?
  completedAt       DateTime?
  createdAt         DateTime                 @default(now())
  updatedAt         DateTime                 @updatedAt
  user              User                     @relation(fields: [userId], references: [id], onDelete: Cascade)
  program           JourneyProgram           @relation(fields: [programId], references: [id])
  ruleSet           JourneyRuleSet           @relation(fields: [ruleSetId], references: [id])
  days              JourneyDayRecord[]
  missionCompletions JourneyMissionCompletion[]
  personalMissions  JourneyPersonalMission[]
  levelReviews      JourneyLevelReview[]
  disciplineTransactions DisciplineTransaction[]
  xpTransactions    JourneyXPTransaction[]
  weeklyChallengeCompletions JourneyWeeklyChallengeCompletion[]
  monthlyChallengeCompletions JourneyMonthlyChallengeCompletion[]
  achievements      JourneyAchievement[]
  expenseEntries    JourneyExpenseEntry[]
  commitmentChecks  JourneyCommitmentCheck[]

  @@index([userId, status])
  @@index([programId, status])
}

model JourneyDayRecord {
  id                       String                    @id @default(cuid())
  journeyId                String
  journeyDay               Int
  date                     DateTime                  @db.Date
  status                   JourneyDayStatus          @default(IN_PROGRESS)
  dailyScore               Int?
  dailyChallengeId         String?
  dailyChallengeCompletedAt DateTime?
  restReason               String?
  completedAt              DateTime?
  createdAt                DateTime                  @default(now())
  updatedAt                DateTime                  @updatedAt
  journey                  UserJourney               @relation(fields: [journeyId], references: [id], onDelete: Cascade)
  dailyChallenge           JourneyDailyChallenge?   @relation(fields: [dailyChallengeId], references: [id], onDelete: SetNull)
  missionCompletions       JourneyMissionCompletion[]
  personalMissions         JourneyPersonalMission[]
  reflection               JourneyReflection?
  expense                  JourneyExpenseEntry?

  @@unique([journeyId, date])
  @@index([journeyId, journeyDay])
  @@index([journeyId, status])
}

// Ghi nhận tối giản "chi tiêu hôm nay" trong thử thách ngày — chỉ lưu số tiền + ghi chú ngắn.
// Phần quản lý chi tiêu đầy đủ (phân loại, ngân sách, báo cáo) sẽ xây ở giai đoạn sau, dựa trên bảng này.
model JourneyExpenseEntry {
  id          String           @id @default(cuid())
  journeyId   String
  dayRecordId String           @unique
  date        DateTime         @db.Date
  amountVnd   Int
  note        String?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  journey     UserJourney      @relation(fields: [journeyId], references: [id], onDelete: Cascade)
  dayRecord   JourneyDayRecord @relation(fields: [dayRecordId], references: [id], onDelete: Cascade)

  @@unique([journeyId, date])
  @@index([journeyId, date])
}

// Đánh dấu hoàn thành từng cam kết cá nhân nhịp WEEKLY (chọn lúc bắt đầu hành trình) theo từng tuần —
// hiển thị/tick ở thẻ "Công việc cần làm" (tab Tuần); Weekly Challenge chỉ cho xác nhận khi đủ cam kết.
model JourneyCommitmentCheck {
  id          String      @id @default(cuid())
  journeyId   String
  weekNumber  Int
  optionId    String
  label       String
  completedAt DateTime    @default(now())
  journey     UserJourney @relation(fields: [journeyId], references: [id], onDelete: Cascade)

  @@unique([journeyId, weekNumber, optionId])
  @@index([journeyId, weekNumber])
}

model JourneyMissionCompletion {
  id          String           @id @default(cuid())
  journeyId   String
  dayRecordId String
  missionId   String
  completedAt DateTime         @default(now())
  journey     UserJourney      @relation(fields: [journeyId], references: [id], onDelete: Cascade)
  dayRecord   JourneyDayRecord @relation(fields: [dayRecordId], references: [id], onDelete: Cascade)
  mission     JourneyMission   @relation(fields: [missionId], references: [id], onDelete: Restrict)
  xpTransaction JourneyXPTransaction?

  @@unique([journeyId, missionId])
  @@index([dayRecordId, completedAt])
  @@index([missionId, completedAt])
}

model JourneyPersonalMission {
  id             String           @id @default(cuid())
  journeyId      String
  dayRecordId    String?
  title          String
  description    String?
  category       String?
  suggestedMinutes Int?
  xpReward       Int              @default(0)
  completedAt    DateTime?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  journey        UserJourney      @relation(fields: [journeyId], references: [id], onDelete: Cascade)
  dayRecord      JourneyDayRecord? @relation(fields: [dayRecordId], references: [id], onDelete: SetNull)

  @@index([journeyId, dayRecordId])
}

model JourneyReflection {
  id          String           @id @default(cuid())
  dayRecordId String           @unique
  mood        Int?
  wins        String?
  lesson      String?
  gratitude   String?
  improvement String?
  answers     Json?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  dayRecord   JourneyDayRecord @relation(fields: [dayRecordId], references: [id], onDelete: Cascade)
}

model JourneyLevelReview {
  id              String         @id @default(cuid())
  journeyId       String
  levelId         String
  completionRate  Int             @default(0)
  passed          Boolean         @default(false)
  answers         Json
  reportSnapshot  Json?
  submittedAt     DateTime        @default(now())
  journey         UserJourney     @relation(fields: [journeyId], references: [id], onDelete: Cascade)
  level           JourneyLevel    @relation(fields: [levelId], references: [id], onDelete: Restrict)

  @@unique([journeyId, levelId])
  @@index([journeyId, submittedAt])
}

model JourneyWeeklyChallengeCompletion {
  id          String                 @id @default(cuid())
  journeyId   String
  challengeId String
  progress    Int                    @default(0)
  completedAt DateTime?
  snapshot    Json?
  createdAt   DateTime               @default(now())
  updatedAt   DateTime               @updatedAt
  journey     UserJourney            @relation(fields: [journeyId], references: [id], onDelete: Cascade)
  challenge   JourneyWeeklyChallenge @relation(fields: [challengeId], references: [id], onDelete: Restrict)

  @@unique([journeyId, challengeId])
  @@index([journeyId, completedAt])
}

model JourneyMonthlyChallengeCompletion {
  id          String                  @id @default(cuid())
  journeyId   String
  challengeId String
  passed      Boolean                 @default(false)
  completedAt DateTime?
  snapshot    Json?
  createdAt   DateTime                @default(now())
  updatedAt   DateTime                @updatedAt
  journey     UserJourney             @relation(fields: [journeyId], references: [id], onDelete: Cascade)
  challenge   JourneyMonthlyChallenge @relation(fields: [challengeId], references: [id], onDelete: Restrict)

  @@unique([journeyId, challengeId])
  @@index([journeyId, completedAt])
}

model WorkCardEvent {
  id                    String    @id @default(cuid())
  workCardId            String?
  workCardIdSnapshot    String
  actorUserId           String?
  eventType             String
  idempotencyKey        String    @unique
  titleSnapshot         String
  fromDueAt             DateTime?
  toDueAt               DateTime?
  fromAssigneeUserId    String?
  toAssigneeUserId      String?
  fromTeamId            String?
  toTeamId              String?
  fromStatus            String?
  toStatus              String?
  occurredAt            DateTime  @default(now())
  createdAt             DateTime  @default(now())
  actor                 User?     @relation("WorkCardEventActor", fields: [actorUserId], references: [id], onDelete: SetNull)
  disciplineTransactions DisciplineTransaction[]

  @@index([workCardIdSnapshot, occurredAt])
  @@index([actorUserId, occurredAt])
}

model DisciplineTransaction {
  id                       String          @id @default(cuid())
  userId                   String
  journeyId                String?
  workCardEventId          String?
  workCardIdSnapshot       String?
  sourceType               String
  sourceId                 String?
  eventType                String
  points                   Int
  reason                   String
  idempotencyKey           String          @unique
  dueAtSnapshot            DateTime?
  completedAtSnapshot      DateTime?
  statusSnapshot           String?
  assigneeUserIdSnapshot   String?
  occurredAt               DateTime        @default(now())
  adjustmentOfId           String?
  createdAt                DateTime        @default(now())
  user                     User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  journey                  UserJourney?    @relation(fields: [journeyId], references: [id], onDelete: SetNull)
  workCardEvent            WorkCardEvent?  @relation(fields: [workCardEventId], references: [id], onDelete: SetNull)
  adjustmentOf             DisciplineTransaction?  @relation("DisciplineAdjustments", fields: [adjustmentOfId], references: [id], onDelete: SetNull)
  adjustments              DisciplineTransaction[] @relation("DisciplineAdjustments")

  @@index([userId, occurredAt])
  @@index([journeyId, occurredAt])
  @@index([workCardIdSnapshot, occurredAt])
}

model JourneyXPTransaction {
  id                   String                    @id @default(cuid())
  userId               String
  journeyId            String?
  missionCompletionId  String?                   @unique
  eventType            String
  xp                   Int
  reason               String
  idempotencyKey       String                    @unique
  occurredAt           DateTime                  @default(now())
  createdAt            DateTime                  @default(now())
  user                 User                      @relation(fields: [userId], references: [id], onDelete: Cascade)
  journey              UserJourney?              @relation(fields: [journeyId], references: [id], onDelete: SetNull)
  missionCompletion    JourneyMissionCompletion? @relation(fields: [missionCompletionId], references: [id], onDelete: SetNull)

  @@index([userId, occurredAt])
  @@index([journeyId, occurredAt])
}

model JourneyAdminAudit {
  id         String   @id @default(cuid())
  adminId    String
  action     String
  entityType String
  entityId   String?
  before     Json?
  after      Json?
  createdAt  DateTime @default(now())
  admin      User     @relation("JourneyAdminActor", fields: [adminId], references: [id], onDelete: Restrict)

  @@index([adminId, createdAt])
  @@index([entityType, entityId])
}

// ---------- Phòng ban (Workspace / Department / Team) — Phase 1 ----------
// RBAC chi tiết và AI Reports là các giai đoạn sau (xem spec).

model Workspace {
  id          String    @id @default(cuid())
  ownerId     String
  name        String
  description String?
  logo        String?
  archivedAt  DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  owner       User              @relation("WorkspaceOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  members     WorkspaceMember[]
  departments Department[]

  @@index([ownerId])
}

model WorkspaceMember {
  id          String   @id @default(cuid())
  workspaceId String
  userId      String
  role        String // OWNER | ADMIN | MEMBER
  joinedAt    DateTime @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user      User      @relation("WorkspaceMembership", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, userId])
  @@index([userId])
}

model Department {
  id          String    @id @default(cuid())
  workspaceId String
  name        String
  code        String?
  description String?
  icon        String?
  color       String    @default("ochre")
  managerId   String?
  modules     String[]  @default(["overview", "goals", "projects", "tasks", "calendar", "members", "reports"])
  archivedAt  DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  workspace Workspace          @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  manager   User?              @relation("DepartmentManager", fields: [managerId], references: [id], onDelete: SetNull)
  members   DepartmentMember[]
  teams     Team[]

  @@index([workspaceId])
}

model DepartmentMember {
  id           String   @id @default(cuid())
  departmentId String
  userId       String
  role         String // MANAGER | MEMBER | VIEWER
  joinedAt     DateTime @default(now())

  department Department @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  user       User       @relation("DepartmentMembership", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([departmentId, userId])
  @@index([userId])
}

model Team {
  id           String    @id @default(cuid())
  departmentId String
  name         String
  leaderId     String?
  archivedAt   DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  department Department   @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  leader     User?        @relation("TeamLeader", fields: [leaderId], references: [id], onDelete: SetNull)
  members    TeamMember[]
  boards     WorkBoard[]
  cards      WorkCard[]

  @@index([departmentId])
}

model TeamMember {
  id       String   @id @default(cuid())
  teamId   String
  userId   String
  joinedAt DateTime @default(now())

  team Team @relation(fields: [teamId], references: [id], onDelete: Cascade)
  user User @relation("TeamMembership", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([teamId, userId])
  @@index([userId])
}
