// Nội Tại Ẩn — data model
// Giai đoạn 1: Auth, Goals, Projects, Tasks, Habits, Focus, Daily plan, Settings.
// Giai đoạn 2–3 (Reflection, Payment, Community) sẽ mở rộng thêm model.

generator client {
  provider = "prisma-client"
  runtime  = "nodejs"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  USER
  ADMIN
}

enum Plan {
  FREE
  PRO
  TEAM
}

enum ThemePref {
  LIGHT
  DARK
  SYSTEM
}

enum GoalHorizon {
  YEAR
  QUARTER
  MONTH
  WEEK
}

enum GoalStatus {
  ACTIVE
  COMPLETED
  PAUSED
  ARCHIVED
}

enum ProjectStatus {
  ACTIVE
  DONE
  ARCHIVED
}

enum TaskStatus {
  TODO
  DONE
}

// ---------- Auth.js ----------

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  role          Role      @default(USER)
  plan          Plan      @default(FREE)
  planExpiresAt DateTime?

  // Cài đặt giao diện & thói quen làm việc
  locale         String    @default("vi")
  theme          ThemePref @default(SYSTEM)
  accent         String    @default("ochre")
  density        String    @default("comfortable")
  timezone       String    @default("Asia/Ho_Chi_Minh")
  weekStartsOn   Int       @default(1) // 0 = CN, 1 = T2
  focusMinutes   Int       @default(25)
  breakMinutes   Int       @default(5)
  dailyFocusGoal Int       @default(120) // phút
  onboardedAt    DateTime?
  bannedAt       DateTime? // Admin khoá tài khoản
  teamSeats      Int? // số chỗ khi mua gói Team

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  accounts          Account[]
  sessions          Session[]
  goals             Goal[]
  projects          Project[]
  tasks             Task[]
  habits            Habit[]
  habitLogs         HabitLog[]
  focusSessions     FocusSession[]
  orders            Order[]
  workCustomers     WorkCustomer[]
  workBoards        WorkBoard[]
  assignedWorkCards WorkCard[]     @relation("WorkCardAssignee")
  notifications     Notification[] @relation("NotificationUser")
  sentNotifications Notification[] @relation("NotificationActor")
  badges            UserBadge[]
}

model Account {
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([provider, providerAccountId])
}

model Session {
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@id([identifier, token])
}

// ---------- B. Goal System ----------

model Goal {
  id          String      @id @default(cuid())
  userId      String
  title       String
  description String?
  why         String? // Lý do sâu xa — nền tảng "nội tại"
  horizon     GoalHorizon
  year        Int
  quarter     Int? // 1–4
  month       Int? // 1–12
  weekStart   DateTime?   @db.Date // cột mốc tuần: ngày đầu tuần
  status      GoalStatus  @default(ACTIVE)
  color       String      @default("ochre")

  // Mục tiêu đo lường được (tuỳ chọn)
  targetValue  Float?
  currentValue Float   @default(0)
  unit         String?

  dueDate     DateTime? @db.Date
  completedAt DateTime?
  parentId    String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  parent   Goal?     @relation("GoalTree", fields: [parentId], references: [id], onDelete: SetNull)
  children Goal[]    @relation("GoalTree")
  projects Project[]
  tasks    Task[]
  habits   Habit[]

  @@index([userId, horizon, year])
}

model Project {
  id          String        @id @default(cuid())
  userId      String
  goalId      String?
  title       String
  description String?
  status      ProjectStatus @default(ACTIVE)
  dueDate     DateTime?     @db.Date

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user  User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  goal  Goal?  @relation(fields: [goalId], references: [id], onDelete: SetNull)
  tasks Task[]

  @@index([userId, goalId])
}

// ---------- D. Daily Execution ----------

model Task {
  id          String     @id @default(cuid())
  userId      String
  goalId      String?
  projectId   String?
  title       String
  notes       String?
  date        DateTime?  @db.Date // null = backlog / hành động chưa lên lịch
  priority    Int? // 1..3 = Top 3 ưu tiên của ngày
  startTime   String? // "HH:mm" để hiện trên timeline
  estimateMin Int?
  status      TaskStatus @default(TODO)
  completedAt DateTime?
  sortOrder   Int        @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  goal          Goal?          @relation(fields: [goalId], references: [id], onDelete: SetNull)
  project       Project?       @relation(fields: [projectId], references: [id], onDelete: SetNull)
  focusSessions FocusSession[]

  @@index([userId, date])
  @@index([userId, goalId])
}

model FocusSession {
  id             String   @id @default(cuid())
  userId         String
  taskId         String?
  label          String?
  plannedMinutes Int
  actualMinutes  Int
  completed      Boolean  @default(true)
  date           DateTime @db.Date
  startedAt      DateTime
  endedAt        DateTime @default(now())

  user User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  task Task? @relation(fields: [taskId], references: [id], onDelete: SetNull)

  @@index([userId, date])
}

// ---------- C. Habit Tracker ----------

model Habit {
  id           String    @id @default(cuid())
  userId       String
  goalId       String?
  name         String
  description  String?
  icon         String    @default("circle-check")
  color        String    @default("jade")
  // Ngày trong tuần áp dụng (0 = CN … 6 = T7). Rỗng = mỗi ngày.
  daysOfWeek   Int[]     @default([])
  targetPerDay Int       @default(1)
  sortOrder    Int       @default(0)
  archivedAt   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  goal Goal?      @relation(fields: [goalId], references: [id], onDelete: SetNull)
  logs HabitLog[]

  @@index([userId])
}

model HabitLog {
  id      String   @id @default(cuid())
  habitId String
  userId  String
  date    DateTime @db.Date
  count   Int      @default(1)

  createdAt DateTime @default(now())

  habit Habit @relation(fields: [habitId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([habitId, date])
  @@index([userId, date])
}

// ---------- G. Không gian "Công việc" (demo CRM khách hàng) ----------

model WorkCustomer {
  id            String    @id @default(cuid())
  userId        String
  name          String
  email         String
  city          String?
  channel       String // ONLINE | IN_STORE
  orders        Int       @default(0)
  lifetimeCents Int       @default(0)
  lastOrderAt   DateTime?
  tags          String[]  @default([])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model WorkBoard {
  id          String    @id @default(cuid())
  userId      String
  name        String
  description String?
  dueDate     DateTime?
  sortOrder   Int       @default(0)
  createdAt   DateTime  @default(now())

  user  User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  lists WorkList[]

  @@index([userId])
}

model WorkList {
  id        String @id @default(cuid())
  boardId   String
  name      String
  color     String // "muted" | "mist" | "ochre" | "jade"
  sortOrder Int    @default(0)

  board WorkBoard  @relation(fields: [boardId], references: [id], onDelete: Cascade)
  cards WorkCard[]

  @@index([boardId])
}

model WorkCard {
  id             String    @id @default(cuid())
  listId         String
  label          String?
  title          String
  assignee       String? // email đã nhập (hiển thị dù chưa khớp tài khoản nào)
  assigneeUserId String? // khớp với User.email nếu có tài khoản tương ứng
  checklist      Json      @default("[]")
  dueDate        DateTime?
  completedAt    DateTime? // mốc chuyển vào cột "Hoàn thành" — dùng cho báo cáo trước/đúng/trễ hạn
  sortOrder      Int       @default(0)
  createdAt      DateTime  @default(now())

  list         WorkList @relation(fields: [listId], references: [id], onDelete: Cascade)
  assigneeUser User?    @relation("WorkCardAssignee", fields: [assigneeUserId], references: [id], onDelete: SetNull)

  @@index([listId])
  @@index([assigneeUserId])
}

model Notification {
  id        String   @id @default(cuid())
  userId    String // người nhận
  actorId   String? // người gây ra thông báo (có thể null nếu hệ thống)
  type      String // "WORK_CARD_ASSIGNED" | ...
  title     String
  body      String?
  href      String?
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  user  User  @relation("NotificationUser", fields: [userId], references: [id], onDelete: Cascade)
  actor User? @relation("NotificationActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([userId, read])
}

// ---------- G. Payment ----------

enum OrderStatus {
  PENDING
  PAID
  CANCELLED
  EXPIRED
}

enum BillingCycle {
  MONTHLY
  YEARLY
}

model Order {
  id          String       @id @default(cuid())
  code        String       @unique // mã nội dung chuyển khoản, VD: NTA8F3K2Q
  orderCode   Int          @unique // mã số cho PayOS
  userId      String
  plan        Plan
  cycle       BillingCycle
  seats       Int          @default(1)
  amount      Int // VND
  provider    String // payos | sepay | mock
  status      OrderStatus  @default(PENDING)
  checkoutUrl String?
  providerRef String? // mã giao dịch phía cổng thanh toán
  paidAt      DateTime?
  expiresAt   DateTime

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([status, createdAt])
  @@index([userId])
}

model UserBadge {
  userId    String
  code      String
  awardedAt DateTime @default(now())
  meta      String? // VD: tên thử thách

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, code])
}
